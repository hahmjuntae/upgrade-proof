# Vultr Serverless Inference (OpenAI-compatible). Leave empty to use the offline planner.
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_MODEL=qwen3.8-27b
# Sandbox
SANDBOX_IMAGE=node:24-bookworm-slim
SANDBOX_NETWORK=upgrade-proof-sandbox
EGRESS_PROXY_URL=http://egress-proxy:3128
EGRESS_ALLOWLIST=registry.npmjs.org
PORT=8080
